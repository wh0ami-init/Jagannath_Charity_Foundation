-.language-switcher { position: relative; }
+/* Language switch: a small pill inside the main menu, just before "Make a difference".
+   Colours come from variables so it matches the transparent home header (white text)
+   and the light header (dark text) without extra rules. */
+.language-switcher {
+  --ls-ink: #18372f;
+  --ls-line: rgba(24, 55, 47, .28);
+  --ls-on-bg: #18372f;
+  --ls-on-ink: #ffffff;
+  position: relative;
+  display: inline-flex;
+  align-items: center;
+  gap: 2px;
+  flex-shrink: 0;
+  margin: 0;
+  padding: 3px;
+  border: 1px solid var(--ls-line);
+  border-radius: 999px;
+  color: var(--ls-ink);
+  transition: color .3s ease, border-color .3s ease;
+}
+.site-header.is-home:not(.is-scrolled) .language-switcher {
+  --ls-ink: #ffffff;
+  --ls-line: rgba(255, 255, 255, .42);
+  --ls-on-bg: #f3c67d;
+  --ls-on-ink: #14382f;
+}
+/* The opened mobile menu always has a light background, so use dark colours there. */
+.site-header.is-home:not(.is-scrolled) .main-nav.is-open .language-switcher {
+  --ls-ink: #18372f;
+  --ls-line: rgba(24, 55, 47, .28);
+  --ls-on-bg: #18372f;
+  --ls-on-ink: #ffffff;
+}
+.language-globe { width: 15px; height: 15px; margin: 0 2px 0 8px; flex-shrink: 0; opacity: .85; }
+.language-divider { display: none; }
+.language-switcher button {
+  min-height: 30px;
+  padding: 4px 12px;
+  border: 0;
+  border-radius: 999px;
+  background: transparent;
+  color: inherit;
+  font: inherit;
+  font-size: 13px;
+  font-weight: 500;
+  line-height: 1.2;
+  white-space: nowrap;
+  cursor: pointer;
+  transition: background .2s ease, color .2s ease;
+}
+.language-switcher button:hover:not([aria-pressed="true"]) { background: rgba(127, 127, 127, .2); }
+.language-switcher button[aria-pressed="true"] { background: var(--ls-on-bg); color: var(--ls-on-ink); font-weight: 700; }
+.language-switcher button:focus-visible { outline: 2px solid #c87932; outline-offset: 2px; }
 .language-switcher button:disabled { opacity: .65; cursor: wait; }
-.language-switcher-error { position: absolute; top: 100%; right: 0; z-index: 60; width: min(280px, 80vw); padding: 12px; border: 1px solid #c87932; border-radius: 6px; background: #fff; color: #18372f; font-size: 13px; line-height: 1.5; }
