DATABASE_URL=sqlite:///./app.db
JWT_SECRET=replace-with-a-long-random-secret-before-running
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENVIRONMENT=development

# Admin session cookie. Leave blank for sensible defaults (production: SameSite=None; Secure).
# Use "lax" if frontend and API share a site, e.g. www.example.org + api.example.org.
COOKIE_SAMESITE=
# Reverse proxies in front of the API. Blank = 1 in production (Railway), 0 locally.
TRUSTED_PROXY_COUNT=
# Rate limits (defaults shown): 10 logins/IP and 10 failed logins/account per window; 10 form posts/IP per window.
LOGIN_IP_LIMIT=10
LOGIN_USER_FAILURE_LIMIT=10
LOGIN_WINDOW_SECONDS=900
FORM_IP_LIMIT=10
FORM_WINDOW_SECONDS=900
